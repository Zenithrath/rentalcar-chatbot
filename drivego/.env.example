# ─────────────────────────────────────────────
# DriveGo AI Chatbot — Environment Variables
# ─────────────────────────────────────────────
# Salin file ini menjadi .env.local lalu isi API key kamu:
#   cp .env.example .env.local
#
# PENTING: Jangan commit file .env.local ke git!

# API key Google Gemini — dapatkan di https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Model yang digunakan
# Pilihan: gemini-2.0-flash (cepat & gratis), gemini-1.5-pro (lebih canggih)
VITE_GEMINI_MODEL=gemini-2.0-flash

# Nama persona chatbot
VITE_CHATBOT_NAME=Ava
